              "content": "var t = require('assert')\nvar slugify = require('../')\n\ndescribe('locale region tags', () => {\n  it('uses the base language for a region locale', () => {\n    t.equal(slugify('\u00c4 \u00f6 & \u00fc', {locale: 'de-DE'}), 'AE-oe-und-ue')\n    t.equal(slugify('\u00c4 \u00f6 & \u00fc', {locale: 'de_AT'}), 'AE-oe-und-ue')\n  })\n\n  it('keeps the default map for unknown locales', () => {\n    t.equal(slugify('\u00c4 \u00f6 & \u00fc', {locale: 'xx-YY'}), 'A-o-and-u')\n    t.equal(slugify('\u00c4 \u00f6 & \u00fc'), 'A-o-and-u')\n  })\n})\n"

              "file": "test/byte-parse-iec.js",
              "content": "'use strict';\n\nvar assert = require('assert');\nvar bytes = require('..');\n\ndescribe('Test byte parse function with IEC suffixes', function(){\n  it('Should parse KiB, MiB, GiB, TiB and PiB', function(){\n    assert.strictEqual(bytes.parse('1KiB'), 1024);\n    assert.strictEqual(bytes.parse('1.5 MiB'), 1572864);\n    assert.strictEqual(bytes.parse('2gib'), 2 * Math.pow(1024, 3));\n    assert.strictEqual(bytes.parse('1TiB'), Math.pow(1024, 4));\n    assert.strictEqual(bytes.parse('1PiB'), Math.pow(1024, 5));\n  });\n\n  it('Should still parse the existing suffixes', function(){\n    assert.strictEqual(bytes.parse('1KB'), 1024);\n    assert.strictEqual(bytes.parse('1kb'), 1024);\n  });\n});\n"

{
  "info": {
    "name": "Milestone",
    "description": "One request per route in docs/openapi.yaml (the MCP server's GET and DELETE, which answer 405, are left out; /api/mcp has three POST examples instead). Auth is the milestone_actor cookie (usr_client, usr_freelancer, usr_partner); agent requests send Authorization: Bearer {{mandateToken}} from Create a mandate. Set demoRepoPath to a repo built with scripts/make-demo-repo.sh. The /api/dev/paypal routes and /api/disputes/dev answer 404 unless PAYPAL_MODE=simulated; /api/demo/reset answers 404 unless DEMO_MODE=1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "contractId",
      "value": "ctr_demo"
    },
    {
      "key": "milestoneId",
      "value": "mst_1"
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "signature",
      "value": ""
    },
    {
      "key": "deliveryId",
      "value": ""
    },
    {
      "key": "demoRepoPath",
      "value": "/tmp/milestone-demo"
    },
    {
      "key": "mandateId",
      "value": ""
    },
    {
      "key": "mandateToken",
      "value": ""
    },
    {
      "key": "disputeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create contract",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_client"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/contracts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "contracts"
          ]
        },
        "description": "303 redirect to the contract page. Disable follow redirects in Postman to see it.",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "scope",
              "value": "Build a signup flow for a SaaS landing page: form, validation, confirmation page, in three milestones."
            },
            {
              "key": "currency",
              "value": "USD"
            },
            {
              "key": "total",
              "value": "300.00"
            },
            {
              "key": "repo",
              "value": "milestone-demo/landing"
            }
          ]
        }
      }
    },
    {
      "name": "Approve contract (client)",

{
  "info": {
    "name": "Milestone",
    "description": "One request per route in docs/openapi.yaml. Auth is the milestone_actor cookie (usr_client, usr_freelancer, usr_partner). Set demoRepoPath to a repo built with scripts/make-demo-repo.sh. The /api/dev/paypal routes answer 404 unless PAYPAL_MODE=simulated.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "contractId",
      "value": "ctr_demo"
    },
    {
      "key": "milestoneId",
      "value": "mst_1"
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "signature",
      "value": ""
    },
    {
      "key": "deliveryId",
      "value": ""
    },
    {
      "key": "demoRepoPath",
      "value": "/tmp/milestone-demo"
    }
  ],
  "item": [
    {
      "name": "Create contract",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_client"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/contracts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "contracts"
          ]
        },
        "description": "303 redirect to the contract page. Disable follow redirects in Postman to see it.",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "scope",
              "value": "Build a signup flow for a SaaS landing page: form, validation, confirmation page, in three milestones."
            },
            {
              "key": "currency",
              "value": "USD"
            },
            {
              "key": "total",
              "value": "300.00"
            },
            {
              "key": "repo",
              "value": "milestone-demo/landing"
            }
          ]
        }
      }
    },
    {
      "name": "Approve contract (client)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_client"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/contracts/{{contractId}}/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "contracts",
            "{{contractId}}",
            "approve"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "Approve contract (freelancer)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_freelancer"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/contracts/{{contractId}}/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "contracts",
            "{{contractId}}",
            "approve"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "Create funding order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_client"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/milestones/{{milestoneId}}/order",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "milestones",
            "{{milestoneId}}",
            "order"
          ]
        },
        "description": "Returns { orderId }."
      }
    },
    {
      "name": "Capture funding",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_client"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/milestones/{{milestoneId}}/capture",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "milestones",
            "{{milestoneId}}",
            "capture"
          ]
        },
        "description": "Approve the order in the sandbox first.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{orderId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Review: approve",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_client"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/milestones/{{milestoneId}}/review",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "milestones",
            "{{milestoneId}}",
            "review"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"approve\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Review: veto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_client"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/milestones/{{milestoneId}}/review",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "milestones",
            "{{milestoneId}}",
            "review"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"veto\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Review: confirm partial",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_client"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/milestones/{{milestoneId}}/review",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "milestones",
            "{{milestoneId}}",
            "review"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"confirm_partial\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Review: hold",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_client"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/milestones/{{milestoneId}}/review",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "milestones",
            "{{milestoneId}}",
            "review"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"hold\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "PayPal client token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_client"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/paypal/client-token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "paypal",
            "client-token"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "PayPal webhook (example)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "PAYPAL-TRANSMISSION-ID",
            "value": "{{paypal_transmission_id}}"
          },
          {
            "key": "PAYPAL-TRANSMISSION-TIME",
            "value": "{{paypal_transmission_time}}"
          },
          {
            "key": "PAYPAL-TRANSMISSION-SIG",
            "value": "{{paypal_transmission_sig}}"
          },
          {
            "key": "PAYPAL-CERT-URL",
            "value": "{{paypal_cert_url}}"
          },
          {
            "key": "PAYPAL-AUTH-ALGO",
            "value": "{{paypal_auth_algo}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/webhooks/paypal",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "webhooks",
            "paypal"
          ]
        },
        "description": "A hand-made event fails signature verification (400). Real events come from PayPal; use the sandbox webhook simulator. Needs a real PayPal signature in sandbox mode. In PAYPAL_MODE=simulated send header X-Milestone-Simulated: dev instead (the simulator posts its own events).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"WH-EXAMPLE-1\",\n  \"event_type\": \"PAYMENT.CAPTURE.COMPLETED\",\n  \"create_time\": \"2026-10-08T12:00:00Z\",\n  \"resource_type\": \"capture\",\n  \"resource\": {\n    \"id\": \"CAPTURE-ID\",\n    \"status\": \"COMPLETED\",\n    \"amount\": {\n      \"currency_code\": \"USD\",\n      \"value\": \"100.00\"\n    },\n    \"supplementary_data\": {\n      \"related_ids\": {\n        \"order_id\": \"ORDER-ID\"\n      }\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "GitHub webhook (example)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-GitHub-Event",
            "value": "pull_request"
          },
          {
            "key": "X-GitHub-Delivery",
            "value": "{{$guid}}"
          },
          {
            "key": "X-Hub-Signature-256",
            "value": "sha256={{signature}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/webhooks/github",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "webhooks",
            "github"
          ]
        },
        "description": "signature is HMAC-SHA256 of the raw body with GITHUB_WEBHOOK_SECRET.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"closed\",\n  \"pull_request\": {\n    \"number\": 1,\n    \"merged\": true,\n    \"merge_commit_sha\": \"0123456789abcdef0123456789abcdef01234567\",\n    \"title\": \"feat: password strength check\",\n    \"body\": \"\",\n    \"head\": {\n      \"ref\": \"m1-pass\"\n    },\n    \"base\": {\n      \"sha\": \"89abcdef0123456789abcdef0123456789abcdef\"\n    }\n  },\n  \"repository\": {\n    \"full_name\": \"milestone-demo/landing\",\n    \"clone_url\": \"https://github.com/milestone-demo/landing.git\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Resolve operator case",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_partner"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/ops/{{milestoneId}}/resolve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ops",
            "{{milestoneId}}",
            "resolve"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"note\": \"Paid the freelancer by hand in the PayPal dashboard; payout item was returned.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Deliver a commit (manual)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_freelancer"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/milestones/{{milestoneId}}/deliver",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "milestones",
            "{{milestoneId}}",
            "deliver"
          ]
        },
        "description": "Freelancer only; milestone must be funded or held. Resolves the ref with git ls-remote and queues a verify job. Build the repo with scripts/make-demo-repo.sh.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"repoUrl\": \"{{demoRepoPath}}\",\n  \"ref\": \"m1-pass\",\n  \"title\": \"Milestone 1: password strength\",\n  \"note\": \"All tests pass.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Deliver files (upload)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_freelancer"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/milestones/mst_brand_1/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "milestones",
            "mst_brand_1",
            "upload"
          ]
        },
        "description": "Freelancer only. Multipart field \"files\" (up to 10 files, 20 MB each) and optional \"note\". Pick a logo (SVG or PNG at least 1024 px wide) and a PDF style guide with a Typography section for the seeded bakery contract.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "files",
              "type": "file",
              "src": []
            },
            {
              "key": "files",
              "type": "file",
              "src": []
            },
            {
              "key": "note",
              "value": "Logo and style guide for review.",
              "type": "text"
            }
          ]
        }
      }
    },
    {
      "name": "Get a delivered file",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_client"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/files/{{deliveryId}}/logo.svg",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "files",
            "{{deliveryId}}",
            "logo.svg"
          ]
        },
        "description": "Client or freelancer of the contract. deliveryId comes from the upload response."
      }
    },
    {
      "name": "Advance offer",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_freelancer"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/advances/offer?milestoneId={{milestoneId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "advances",
            "offer"
          ],
          "query": [
            {
              "key": "milestoneId",
              "value": "{{milestoneId}}"
            }
          ]
        },
        "description": "Freelancer only. Prices an advance against a funded milestone, or returns the existing one."
      }
    },
    {
      "name": "Accept advance (Get paid now)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_freelancer"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/advances/accept",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "advances",
            "accept"
          ]
        },
        "description": "Freelancer only. 201 when created, 200 when the milestone already has an advance. Queues the advance job.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"milestoneId\": \"{{milestoneId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Simulated PayPal mode",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_client"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/dev/paypal/mode",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dev",
            "paypal",
            "mode"
          ]
        },
        "description": "Answers simulated or sandbox."
      }
    },
    {
      "name": "Simulated checkout approve",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_client"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/dev/paypal/approve?order={{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dev",
            "paypal",
            "approve"
          ],
          "query": [
            {
              "key": "order",
              "value": "{{orderId}}"
            }
          ]
        },
        "description": "Only while PAYPAL_MODE=simulated (404 otherwise). 303 back to the contract page. Disable follow redirects to see it."
      }
    },
    {
      "name": "Arm a simulated payout failure",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_partner"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/dev/paypal/fail",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dev",
            "paypal",
            "fail"
          ]
        },
        "description": "Only while PAYPAL_MODE=simulated. The next payout item with this sender_item_id fails once, so the release goes to held with milestone.needs_operator.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sender_item_id\": \"{{milestoneId}}:freelancer\",\n  \"reason\": \"RECEIVER_ACCOUNT_LOCKED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "List armed simulated failures",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "milestone_actor=usr_partner"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/dev/paypal/fail",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dev",
            "paypal",
            "fail"
          ]
        },
        "description": "Only while PAYPAL_MODE=simulated."
      }
    }
  ]
}

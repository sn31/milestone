            "key": "Cookie",
            "value": "milestone_actor=usr_freelancer"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/contracts/{{contractId}}/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [

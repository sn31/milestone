        ],
        "url": {
          "raw": "{{baseUrl}}/api/contracts/{{contractId}}/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "contracts",
            "{{contractId}}",
            "approve"
          ]
        },
        "description": ""
      }
    },
    {

ire('../src/password');\n+\n+test('a strong password passes', () => {\n+  const result = checkPasswordStrength('Correct1horse');\n+  assert.equal(result.ok, true);\n+  assert.deepEqual(result.missing, []);\n+});\n+\n+test('a short password is rejected for length', () => {\n+  const result = checkPasswordStrength('Ab1');\n+  assert.equal(result.ok, false);\n+  assert.ok(result.missing.includes('at least 8 characters'));\n+});\n+\n+test('missing character classes are reported', () => {\n+  const result = checkPasswordStrength('alllowercase1');\n+  assert.equal(result.ok, false);\n+  assert.ok(result.missing.includes('an uppercase letter'));\n+});\n+\n+test('a non-string password is rejected', () => {\n+  assert.equal(checkPasswordStrength(12345678).ok, false);\n+});\n"}, {"id": "evd_tree", "kind": "file", "summary": "9 file(s) in the delivered commit:\nREADME.md\npackage.json\npublic/index.html\nsrc/password.js\nsrc/pricing.js\nsrc/signup.js\ntest/password.test.js\ntest/pricing.test.js\ntest/signup.test.js"}, {"id": "evd_commit", "kind": "note", "summary": "commit message:\nfeat: password strength check\n\ndelivery title: Manual delivery of m1-pass"}], "rawVerdict": {"delivery_id": "dlv_21", "criteria": [{"criterion_id": "tests", "status": "pass", "confidence": 1, "evidence_ids": ["evd_tests"], "rationale": "Deterministic run passed."}, {"criterion_id": "judge", "status": "pass", "confidence": 0.9, "evidence_ids": ["evd_diff"], "rationale": "src/password.js checks length, lower case, upper case and digits; test/password.test.js covers them."}], "suspected_injection": false}, "deliveryTexts": [{"source": "commit_message", "text": "feat: password strength check"}], "expected": {"result": "pass", "action": "release", "suspectedInjection": false}},

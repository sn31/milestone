# Local run with no keys: leave every PayPal, Anthropic and GitHub value blank. Only DATABASE_URL (below) matters,
# and its default matches `docker compose up -d`.

# --- PayPal mode ---
# simulated = a local simulator answers the same REST calls and posts its own webhooks: no PayPal account or keys.
# sandbox = the real PayPal sandbox app below (what the hosted demo on Render runs; every variable in the next section
# is needed, see docs/deploy.md). Unset: simulated when PAYPAL_CLIENT_ID is empty and NODE_ENV != production.
# Locally in sandbox mode, checkout, captures, refunds and payout calls work, but a payout is only confirmed (Released)
# when PayPal's webhook reaches APP_URL, which localhost cannot receive.
# Web and worker share the simulator's state in var/simulated-paypal.json (delete it to reset; override the path
# with SIMULATED_PAYPAL_STATE_FILE). Dev controls: POST /api/dev/paypal/fail {"sender_item_id":"<milestoneId>:freelancer"}.
PAYPAL_MODE=simulated
# Simulated webhooks carry X-Milestone-Simulated: <this>. Defaults to "dev" outside production; required in production.
SIMULATED_WEBHOOK_SECRET=

# --- PayPal sandbox (PAYPAL_MODE=sandbox; Developer Dashboard > Apps & Credentials > Sandbox; enable Payouts and Vault) ---
# PAYPAL_ENV: unset = sandbox. Never "live" for the hackathon.
PAYPAL_ENV=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Capital partner sandbox business account used for advances (its own app credentials)
PAYPAL_PARTNER_CLIENT_ID=
PAYPAL_PARTNER_CLIENT_SECRET=
# Sandbox accounts the seed assigns as PayPal receivers (also used by the spike script)
PAYPAL_FREELANCER_EMAIL=
PAYPAL_PARTNER_EMAIL=
SPIKE_FREELANCER_EMAIL=
# Optional: the platform's email, printed on receipts
PAYPAL_PLATFORM_EMAIL=

# --- Model ---
# Claude judges judgment criteria, compiles contracts, writes explanations and drives the agent console.
# Without a key those fall back: judgment criteria go to the client, the contract form builds a fixed demo contract.
ANTHROPIC_API_KEY=
# Optional: a Claude model id (claude-*); unset = claude-sonnet-5-5
MILESTONE_MODEL=

# --- Data (jobs live here too) ---
# Matches `docker compose up -d`. With your own Postgres, or the compose port moved (POSTGRES_PORT=5433 here, then
# localhost:5433 below), change it here: web, worker, seed and db:migrate all read this line.
DATABASE_URL=postgres://milestone:milestone@localhost:5432/milestone

# 1 = the manual deliver route accepts file:// URLs and absolute local paths (otherwise only outside production with PAYPAL_MODE=simulated; https is always accepted). Never with DEMO_MODE=1
MILESTONE_ALLOW_LOCAL_REPOS=

# --- Hosted demo ---
# 1 = the public demo: demo band and reset, allowlisted test/build commands, rate limits, and code deliveries only from DEMO_REPO_URL
DEMO_MODE=
# With DEMO_MODE=1, the only repository code deliveries are accepted from (https, e.g. https://github.com/<you>/landing).
# Unset with DEMO_MODE=1 = every code delivery is refused; file uploads still work. Also the seed's and deliver form's suggestion
DEMO_REPO_URL=

# --- GitHub: repository webhook in, PR comment out ---
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# --- Demo clock (seconds). 48h in production, 120s on stage ---
REVIEW_WINDOW_SECONDS=172800
APP_URL=http://localhost:3000

# --- Optional storage paths (defaults under var/) ---
# UPLOAD_DIR: uploaded deliveries. MILESTONE_UPLOAD_BUDGET_BYTES: refuse file deliveries past this total (default 500 MB).
# MILESTONE_NPM_CACHE: npm cache for verification runs. See docs/deploy.md.
UPLOAD_DIR=
MILESTONE_UPLOAD_BUDGET_BYTES=
MILESTONE_NPM_CACHE=
